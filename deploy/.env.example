# ==============================================================================
# Toppa Load — Contoh Variabel Environment (Lokal & Coolify)
# Salin ke .env (lokal, jangan di-commit) atau masukkan di Environment Coolify
# ==============================================================================

# --- Profil & Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50.0 -Xmx512m -Duser.timezone=UTC

# --- Database PostgreSQL 17 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=toppaload
POSTGRES_USER=toppaload
POSTGRES_PASSWORD=ganti_dengan_password_acak_minimal_32_karakter
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/toppaload
SPRING_DATASOURCE_USERNAME=toppaload
SPRING_DATASOURCE_PASSWORD=ganti_dengan_password_acak_minimal_32_karakter

# --- Keamanan & Bootstrap Admin ---
# Email ini otomatis dijamin aktif sebagai role ADMIN saat startup aplikasi
APP_SECURITY_BOOTSTRAP_ADMIN_EMAIL=admin@perusahaan-anda.co.id
APP_SECURITY_BOOTSTRAP_ADMIN_NAME=Admin Workload
APP_WORK_TIMEZONE=Asia/Jakarta
APP_ALLOCATION_MEMBER_TENTATIVE_ENABLED=true

# --- SSO OIDC: Google Workspace (Default) ---
GOOGLE_CLIENT_ID=isi-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=isi-google-oauth-client-secret

# --- SSO OIDC: Microsoft Entra ID (Opsional, bila tim memakai Microsoft 365) ---
# MICROSOFT_TENANT_ID=isi-tenant-id
# MICROSOFT_CLIENT_ID=isi-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=isi-microsoft-client-secret

# --- Email Transaksional SMTP (Resend / Brevo / Mailpit Lokal) ---
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_isi_api_key_smtp_anda
APP_MAIL_FROM=workload-noreply@domain-anda.co.id
APP_BASE_URL=https://workload.domain-anda.co.id

# --- Observability (Opsional — Tier Gratis) ---
SENTRY_DSN=
